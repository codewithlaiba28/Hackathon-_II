# Frontend Environment Variables

# Backend API URL (required for production deployment)
# For local development, this defaults to http://127.0.0.1:8000
# For Vercel deployment, set this to your backend URL (e.g., https://todo-api.vercel.app)
NEXT_PUBLIC_API_URL=

# Database Connection String (PostgreSQL)
# For Vercel deployment, use Neon.tech or similar PostgreSQL provider
# Example: postgresql://user:pass@ep-cool-name.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Better Auth Configuration
# Generate a random 32-character string for production
# Must match the BETTER_AUTH_SECRET in the backend
BETTER_AUTH_SECRET=

# Better Auth URL (your frontend URL)
# For local: http://localhost:3000
# For production: https://your-app.vercel.app
BETTER_AUTH_URL=http://localhost:3000
