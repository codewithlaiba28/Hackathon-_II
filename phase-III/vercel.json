{
    "version": 2,
    "functions": {
        "backend/main.py": {
            "runtime": "vercel-python@3.11",
            "includeFiles": "mcp-servers/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "backend/main.py"
        }
    ]
}