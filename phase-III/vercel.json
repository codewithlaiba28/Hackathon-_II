{
    "version": 2,
    "functions": {
        "api/index.py": {
            "includeFiles": "mcp-servers/**"
        }
    },
    "rewrites": [
        {
            "source": "/api/(.*)",
            "destination": "/api/index.py"
        },
        {
            "source": "/openapi.json",
            "destination": "/api/index.py"
        },
        {
            "source": "/docs",
            "destination": "/api/index.py"
        }
    ]
}